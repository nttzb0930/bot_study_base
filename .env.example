# Telegram Bot Token (Get it from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# UNETI API Configuration
API_BASE_URL=https://apiv3.uneti.edu.vn/api
CRYPTOJS_KEY=fd85b494-Uneti

# Local File Storage Fallback Configuration
TOKEN_FILE=tokens.json
SETTINGS_FILE=user_settings.json
SCORES_FILE=user_scores.json

# Cache and Auto-delete settings
CHECK_CONTEXT_TTL_SECONDS=3600
AUTO_DELETE_MESSAGES_SECONDS=300

# Security secret for /api/cron endpoint (Vercel Cron Jobs)
CRON_SECRET=your_local_cron_secret_here

# MongoDB Connection URI (Leave blank to use local JSON storage fallback)
MONGODB_URI=your_mongodb_connection_uri_here

# Redis URL for caching (e.g., Upstash Redis link. Leave blank to fall back to In-Memory RAM cache)
REDIS_URL=rediss://default:your_password_here@your_redis_host_here:6379

# Cache time-to-live in seconds (Default: 300 seconds / 5 minutes)
CACHE_TTL_SECONDS=300

# Primary Telegram User ID to act as administrator for public lookup requests
ADMIN_TELEGRAM_ID=your_telegram_id_here
